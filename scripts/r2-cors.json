{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://chopenguin.github.io",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match"]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "ETag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
